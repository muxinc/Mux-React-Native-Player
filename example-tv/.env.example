# Copy to .env.local (ignored). These values are public in the compiled app.
# Never enter Mux API access tokens, signing key IDs/private keys, or DRM secrets.
EXPO_PUBLIC_MUX_ENV_KEY=
# Opt in to status/current time/duration in development with 1. Unset/0 hides it.
EXPO_PUBLIC_MUX_TV_QA_STATUS=
# Both are required before the Signed VOD card appears.
EXPO_PUBLIC_MUX_SIGNED_PLAYBACK_ID=
EXPO_PUBLIC_MUX_PLAYBACK_TOKEN=
# Image JWT has a separate audience; do not reuse the playback token.
EXPO_PUBLIC_MUX_THUMBNAIL_TOKEN=
# Live card appears only with an ID. Token is optional for a public live stream.
EXPO_PUBLIC_MUX_LIVE_PLAYBACK_ID=
EXPO_PUBLIC_MUX_LIVE_PLAYBACK_TOKEN=

# Optional connected Robots card. Asset and playback IDs must refer to your video.
EXPO_PUBLIC_MUX_ROBOTS_ASSET_ID=
EXPO_PUBLIC_MUX_ROBOTS_PLAYBACK_ID=
# Trusted backend URL; never put API credentials in the client.
EXPO_PUBLIC_ROBOTS_API_URL=
