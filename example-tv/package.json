{
  "name": "mux-react-native-player-tv-example",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo start --dev-client",
    "prebuild": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo prebuild --no-install --no-clean",
    "prebuild:ios": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo prebuild --platform ios --no-install --no-clean",
    "prebuild:android": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo prebuild --platform android --no-install --no-clean",
    "ios": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo run:ios",
    "android": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo run:android",
    "ios:pods": "cd ios && EXPO_TV=1 RCT_BUILD_FOR_TV=1 pod install",
    "ios:build": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 xcodebuild -packageAuthorizationProvider netrc -workspace ios/MuxPlayerTV.xcworkspace -scheme MuxPlayerTV -configuration Debug -sdk appletvsimulator -destination \"generic/platform=tvOS Simulator\" -derivedDataPath build/DerivedData build CODE_SIGNING_ALLOWED=NO -quiet",
    "android:build": "cd android && ./gradlew :app:assembleDebug",
    "typecheck": "tsc --noEmit",
    "export": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo export --platform ios --platform android",
    "prebuild:clean": "EXPO_TV=1 RCT_BUILD_FOR_TV=1 expo prebuild --no-install"
  },
  "dependencies": {
    "@mux/mux-react-native-player": "file:..",
    "expo": "57.0.22",
    "expo-dev-client": "57.0.19",
    "expo-linear-gradient": "57.0.2",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.6",
    "@types/react": "19.2.14",
    "babel-preset-expo": "57.0.11",
    "typescript": "6.0.3"
  }
}
