{
  "name": "mux-react-native-player-example",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "node scripts/run-ios.cjs",
    "ios:build": "xcodebuild -workspace ios/MuxReactNativePlayerExample.xcworkspace -scheme MuxReactNativePlayerExample -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" -derivedDataPath build/DerivedData build CODE_SIGNING_ALLOWED=NO -quiet",
    "ios:launch": "expo run:ios --binary build/DerivedData/Build/Products/Debug-iphonesimulator/MuxReactNativePlayerExample.app",
    "ios:metro": "expo start --clear --host localhost --port 8081",
    "ios:expo": "expo run:ios --scheme MuxReactNativePlayerExample",
    "robots": "node scripts/robots-server.cjs",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios",
    "postinstall": "cd .. && patch-package --patch-dir example/patches --error-on-fail",
    "android:build": "cd android && ./gradlew :app:assembleDebug"
  },
  "dependencies": {
    "@mux/mux-react-native-player": "file:..",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.22",
    "expo-asset": "57.0.17",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-screen-orientation": "57.0.2",
    "expo-status-bar": "57.0.1",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.11",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3"
  }
}
